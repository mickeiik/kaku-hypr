# Lock and screen off when idle (started by ~/.config/hypr/conf.d/90-idle.lua),
# with the Quickshell lock screen (falling back to swaylock, see ~/.local/bin/lock-screen).
#   5 min idle: lock      6 min idle: screen off
#   already locked (Quickshell lock screen or swaylock): screen off after 1 min idle
# No unlock hook: only the password (or a fingerprint) unlocks, `loginctl
# unlock-session` doesn't.
timeout 300 '~/.local/bin/lock-screen'
timeout 360 'hyprctl dispatch "hl.dsp.dpms({ action = \"off\" })"' resume 'hyprctl dispatch "hl.dsp.dpms({ action = \"on\" })"'
timeout 60 '{ [ "$(timeout 2 qs ipc call lock isLocked)" = true ] || pgrep -xu "$USER" swaylock >/dev/null; } && hyprctl dispatch "hl.dsp.dpms({ action = \"off\" })"' resume 'hyprctl dispatch "hl.dsp.dpms({ action = \"on\" })"'
before-sleep '~/.local/bin/lock-screen --wait'
lock '~/.local/bin/lock-screen'
